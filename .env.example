# ===== 环境变量配置示例 =====
# 复制本文件为 .env 并填入你自己的值（.env 已加入 .gitignore，不会被传到 GitHub）
# 获取方法：登录 Supabase → 左侧 Project Settings → API Keys

# Supabase 项目地址（格式固定为 https://你的项目ID.supabase.co）
SUPABASE_URL=https://你的项目ID.supabase.co

# Supabase 匿名公钥（新版为 sb_publishable_ 开头，在 API Keys 页面复制）
SUPABASE_ANON_KEY=sb_publishable_你的key
